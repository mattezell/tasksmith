{
  "name": "tasksmith-cli",
  "version": "1.0.1",
  "description": "The unattended ops layer for Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tasksmith": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "clean": "rm -rf dist/",
    "prepublishOnly": "npm run build",
    "release": "npm run build && npm publish",
    "stats": "node scripts/update-stats.mjs"
  },
  "files": [
    "dist/",
    "templates/",
    ".claude/skills/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "claude-code",
    "agent",
    "orchestration",
    "task-engine",
    "ai",
    "automation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "fastify": "^4.28.0",
    "inquirer": "^9.3.0",
    "js-yaml": "^4.1.0",
    "ora": "^8.0.0",
    "undici": "^6.19.0",
    "uuid": "^10.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "optionalDependencies": {
    "discord.js": "^14.15.0"
  },
  "homepage": "https://tasksmith.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattezell/tasksmith.git"
  },
  "bugs": {
    "url": "https://github.com/mattezell/tasksmith/issues"
  },
  "author": "Matt Ezell (https://github.com/mattezell)"
}
